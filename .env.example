# JARVIS Ω∞ OS v2 — miljövariabler (lokal .env — commit ALDRIG)

# --- Kostnadsdimmer (FREE / LOW / MED / HIGH) ---
JARVIS_TIER=LOW
# Missing means blocked, NOT zero spend. A trusted current meter must supply it.
JARVIS_MONTH_SPEND_PCT=
JARVIS_NOTIFY=1
JARVIS_DRY_RUN=1

# --- Comet (fallback + MED/HIGH) ---
COMET_API_KEY=

# --- Gratis-providers (FREE-tier fallback-kedja) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_API_KEY=

# --- Hugging Face: prepared text profile, OFF until separately approved ---
HF_TOKEN=
HF_EXPECTED_USERNAME=rickyraippalinna
JARVIS_PROVIDER=default
JARVIS_ENABLE_HUGGINGFACE=0
JARVIS_HF_POLICY_PATH=config/huggingface.json
JARVIS_HF_CATALOG_PATH=runtime/huggingface-catalog.json
# Trusted budget timestamp, not generated by this job and not a hard monthly ledger.
JARVIS_HF_BUDGET_CHECKED_AT=

# --- Minne (Supabase pgvector) ---
SUPABASE_URL=https://fzmnqvmfilqizzftphbt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Scope must come from trusted deployment config, not an end-user prompt.
JARVIS_MEMORY_ACTOR=
JARVIS_MEMORY_TENANT_ID=
JARVIS_MEMORY_USER_ID=
JARVIS_MEMORY_MAX_SENSITIVITY=internal
JARVIS_ENABLE_SHARED_CONTEXT=0

# --- Perplexity Router: opt-in, no model or quality score is guessed ---
PERPLEXITY_API_KEY=
JARVIS_ENABLE_PERPLEXITY=0
JARVIS_ROUTER_DATA_APPROVED=0
JARVIS_PERPLEXITY_MODEL=
JARVIS_ROUTER_TIER=
JARVIS_ROUTER_MODELS_PATH=
JARVIS_ROUTER_USD_SEK=
JARVIS_ROUTER_QUALITY_INDEX=

# --- Notion (resultat-postback + Control Room-läsning) ---
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_LOG_PAGE_ID=
NOTION_DB_BESLUTSLOGG=
NOTION_DB_INITIATIV=
NOTION_DB_RADAR=

# --- Slack-alerts (välj EN metod: webhook eller bot-token+user-id) ---
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_USER_ID=
