@@ -0,0 +1,15 @@
+"""Tomma modellsvar ska ha kvalitet noll."""
+import pytest
+from jarvis.core import supervisor
+
+@pytest.mark.parametrize("answer", [
+    "(tomt svar från modellen)", "  (tomt svar från modellen)\n",
+    "", " \n\t", "[JARVIS-fel] test",
+])
+def test_empty_model_answer_quality_zero(answer):
+    assert supervisor._quality_score(answer, "Status?") == 0.0
+
+def test_normal_answer_quality_unchanged():
+    assert supervisor._quality_score("Ett riktigt svar", "Status?") == 0.8
+def test_quantified_answer_quality_unchanged():
+    assert supervisor._quality_score("Kostnad 10 kr", "Status?") == 0.85
